<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Angel Cars | SEO Strategy & 4-Phase Implementation Plan</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0a1020;
    --bg2:#0f1830;
    --card:rgba(255,255,255,.045);
    --card-b:rgba(255,255,255,.09);
    --text:#e8ecf6;
    --muted:#9aa6c2;
    --a:#38bdf8;
    --p1:#38bdf8;
    --p2:#a78bfa;
    --p3:#34d399;
    --p4:#fbbf24;
    --max:1180px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;scroll-padding-top:76px}
  body{background:var(--bg);color:var(--text);font-family:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
    -webkit-font-smoothing:antialiased;line-height:1.6;overflow-x:hidden}
  h1,h2,h3{font-family:'Playfair Display',Georgia,serif;font-weight:700;line-height:1.15}
  a{color:inherit}

  /* Background */
  .bg{position:fixed;inset:0;z-index:-1;
    background:radial-gradient(1100px 600px at 90% -10%,rgba(56,189,248,.13),transparent 60%),
               radial-gradient(900px 600px at -10% 40%,rgba(167,139,250,.10),transparent 60%),
               radial-gradient(900px 600px at 100% 100%,rgba(251,191,36,.07),transparent 60%),
               linear-gradient(170deg,var(--bg),var(--bg2));}
  .bg::after{content:"";position:absolute;inset:0;
    background-image:linear-gradient(rgba(255,255,255,.022) 1px,transparent 1px),
                     linear-gradient(90deg,rgba(255,255,255,.022) 1px,transparent 1px);
    background-size:56px 56px;
    mask-image:linear-gradient(#000,transparent 85%);-webkit-mask-image:linear-gradient(#000,transparent 85%)}

  .wrap{width:100%;max-width:var(--max);margin:0 auto;padding:0 clamp(18px,4vw,36px)}

  /* Progress + Nav */
  .progress{position:fixed;top:0;left:0;height:3px;width:0;z-index:60;
    background:linear-gradient(90deg,var(--p1),var(--p2),var(--p3),var(--p4))}
  .nav{position:sticky;top:0;z-index:50;background:rgba(10,16,32,.78);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    border-bottom:1px solid var(--card-b)}
  .nav .wrap{display:flex;align-items:center;justify-content:space-between;gap:18px;height:60px}
  .brand{font-family:'Playfair Display',serif;font-weight:700;font-size:1.05rem;white-space:nowrap;text-decoration:none}
  .brand span{color:var(--p1)}
  .links{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
  .links::-webkit-scrollbar{display:none}
  .links a{white-space:nowrap;text-decoration:none;font-size:.8rem;font-weight:600;color:var(--muted);
    padding:8px 14px;border-radius:999px;border:1px solid transparent;transition:.25s}
  .links a:hover{color:var(--text);background:var(--card)}
  .links a.on{color:#0a1020;background:var(--c,var(--p1))}

  /* Hero */
  .hero{padding:clamp(60px,10vw,130px) 0 clamp(40px,6vw,80px);position:relative}
  .badge{display:inline-block;padding:8px 16px;border:1px solid var(--card-b);background:var(--card);
    border-radius:999px;font-size:.78rem;color:var(--muted);margin-bottom:26px}
  .hero h1{font-size:clamp(2.3rem,7vw,5.2rem);max-width:15ch;
    background:linear-gradient(120deg,#fff 35%,var(--p1));-webkit-background-clip:text;background-clip:text;color:transparent}
  .hero .sub{margin-top:22px;font-size:clamp(1rem,2vw,1.25rem);color:var(--muted);max-width:60ch}
  .meta{margin-top:38px;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;max-width:900px}
  .chip{padding:16px 20px;background:var(--card);border:1px solid var(--card-b);border-radius:14px;min-width:0}
  .chip small{display:block;font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
  .chip span,.chip a{font-weight:600;font-size:.96rem;word-break:break-word}
  .chip a{color:var(--p1);text-decoration:none}
  .scroll-hint{margin-top:44px;display:inline-flex;align-items:center;gap:10px;font-size:.78rem;color:var(--muted);letter-spacing:.14em;text-transform:uppercase}
  .scroll-hint i{width:22px;height:34px;border:2px solid var(--card-b);border-radius:14px;position:relative}
  .scroll-hint i::after{content:"";position:absolute;left:50%;top:6px;width:4px;height:7px;border-radius:3px;background:var(--p1);
    transform:translateX(-50%);animation:wheel 1.6s infinite}
  @keyframes wheel{0%{opacity:1;transform:translate(-50%,0)}100%{opacity:0;transform:translate(-50%,12px)}}

  .eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:.76rem;font-weight:700;letter-spacing:.18em;
    text-transform:uppercase;color:var(--a)}
  .eyebrow::before{content:"";width:30px;height:2px;background:var(--a);border-radius:2px}

  /* Overview */
  .section{padding:clamp(40px,7vw,90px) 0}
  .section h2.title{font-size:clamp(1.8rem,4.2vw,3rem);margin:14px 0 12px}
  .lead{color:var(--muted);max-width:70ch;font-size:clamp(.95rem,1.5vw,1.08rem)}
  .roadmap{margin-top:40px;display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:20px}
  .rm{background:var(--card);border:1px solid var(--card-b);border-top:3px solid var(--c);border-radius:18px;padding:24px;
    text-decoration:none;display:block;transition:transform .3s,background .3s}
  .rm:hover{transform:translateY(-6px);background:rgba(255,255,255,.07)}
  .rm .dot{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;font-family:'Playfair Display',serif;
    font-weight:800;font-size:1.2rem;color:#0a1020;background:var(--c);margin-bottom:16px;box-shadow:0 10px 26px -8px var(--c)}
  .rm h3{font-size:1.1rem;margin-bottom:8px}
  .rm p{font-size:.86rem;color:var(--muted)}
  .rm .go{display:inline-block;margin-top:14px;font-size:.78rem;font-weight:700;color:var(--c);letter-spacing:.06em}

  /* Phase */
  .phase{position:relative;padding:clamp(50px,8vw,100px) 0;border-top:1px solid var(--card-b)}
  .phase-head{display:grid;grid-template-columns:1fr auto;align-items:center;gap:20px;margin-bottom:clamp(26px,4vw,46px)}
  .phase-head h2{font-size:clamp(1.7rem,4.4vw,3.2rem);margin:14px 0 14px;max-width:22ch}
  .phase-head p{color:var(--muted);max-width:68ch;font-size:clamp(.95rem,1.5vw,1.1rem)}
  .phase-num{font-family:'Playfair Display',serif;font-weight:800;font-size:clamp(5rem,16vw,12rem);line-height:.8;
    color:transparent;-webkit-text-stroke:2px var(--a);opacity:.32;user-select:none}
  .toc{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:clamp(24px,4vw,40px)}
  .toc span{padding:6px 13px;border-radius:999px;font-size:.74rem;border:1px solid var(--card-b);background:var(--card);color:var(--text)}

  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,310px),1fr));gap:20px}
  .card{background:var(--card);border:1px solid var(--card-b);border-radius:18px;padding:24px 24px 26px;position:relative;overflow:hidden;
    transition:transform .3s,border-color .3s,background .3s}
  .card:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--a) 55%,transparent);background:rgba(255,255,255,.065)}
  .card::before{content:"";position:absolute;left:0;top:0;width:100%;height:3px;background:linear-gradient(90deg,var(--a),transparent)}
  .card .num{font-family:'Playfair Display',serif;font-size:.9rem;color:var(--a);font-weight:700;letter-spacing:.1em}
  .card h3{font-size:clamp(1.05rem,1.8vw,1.25rem);margin:6px 0 14px}
  .card ul{list-style:none;display:grid;gap:10px}
  .card li{position:relative;padding-left:28px;font-size:.92rem;color:#d5dbec;line-height:1.5}
  .card li::before{content:"";position:absolute;left:0;top:.2em;width:16px;height:16px;border-radius:50%;
    background:color-mix(in srgb,var(--a) 20%,transparent);border:1.5px solid var(--a)}
  .card li::after{content:"";position:absolute;left:5.5px;top:calc(.2em + 3px);width:4px;height:7px;
    border:solid var(--a);border-width:0 2px 2px 0;transform:rotate(45deg)}
  .card.report{background:linear-gradient(135deg,color-mix(in srgb,var(--a) 15%,transparent),var(--card));
    border-color:color-mix(in srgb,var(--a) 40%,transparent)}
  .card.report .tagrep{position:absolute;top:18px;right:18px;font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;
    font-weight:700;padding:4px 10px;border-radius:999px;background:var(--a);color:#0a1020}

  /* Closing */
  .closing{text-align:center;padding:clamp(60px,9vw,120px) 0;border-top:1px solid var(--card-b)}
  .closing h2{font-size:clamp(2rem,5vw,3.6rem);margin:16px auto;max-width:18ch}
  .closing p{color:var(--muted);max-width:60ch;margin:0 auto}
  .closing .eyebrow::before{display:none}
  .cta{margin-top:30px;display:inline-block;padding:14px 28px;border-radius:999px;font-weight:700;text-decoration:none;
    background:linear-gradient(120deg,var(--p1),var(--p2));color:#0a1020;font-size:.95rem;transition:transform .25s}
  .cta:hover{transform:translateY(-3px)}
  footer{padding:26px 0 40px;text-align:center;font-size:.78rem;color:var(--muted);border-top:1px solid var(--card-b)}

  /* Back to top */
  .top{position:fixed;right:20px;bottom:20px;width:46px;height:46px;border-radius:50%;border:1px solid var(--card-b);
    background:rgba(10,16,32,.85);color:var(--text);cursor:pointer;display:grid;place-items:center;z-index:40;
    opacity:0;pointer-events:none;transform:translateY(10px);transition:.3s;backdrop-filter:blur(8px)}
  .top.show{opacity:1;pointer-events:auto;transform:none}
  .top:hover{background:var(--p1);color:#0a1020}
  .top svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}

  /* Reveal animation */
  .reveal{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s ease}
  .reveal.in{opacity:1;transform:none}

  /* Responsive */
  @media (max-width:760px){
    .brand{display:none}
    .nav .wrap{height:56px}
    .phase-head{grid-template-columns:1fr}
    .phase-num{position:absolute;right:16px;top:30px;font-size:5.5rem;opacity:.16}
    html{scroll-padding-top:64px}
    .grid{grid-template-columns:1fr}
  }
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto}
    .reveal{opacity:1;transform:none;transition:none}
    .scroll-hint i::after{animation:none}
  }
  @media print{
    .bg,.nav,.progress,.top,.scroll-hint{display:none}
    body{background:#0a1020;-webkit-print-color-adjust:exact;print-color-adjust:exact}
    .reveal{opacity:1;transform:none}
    .card,.rm{break-inside:avoid}
    .phase{break-before:page}
  }
</style>
</head>
<body>
<div class="bg"></div>
<div class="progress" id="progress"></div>

<header class="nav">
  <div class="wrap">
    <a class="brand" href="#top-of-page">Angel Cars <span>SEO</span></a>
    <nav class="links" id="links"></nav>
  </div>
</header>

<main id="top-of-page">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <span class="badge reveal">SEO Strategy &amp; 4-Phase Implementation Plan</span>
      <h1 class="reveal">Angel Cars<br>SEO Roadmap</h1>
      <p class="sub reveal">A structured, four-phase plan to build a strong SEO foundation, resolve technical issues, grow local and content authority, and win visibility in AI search.</p>
      <div class="meta reveal">
        <div class="chip"><small>Client</small><span>Angel Cars</span></div>
        <div class="chip"><small>Website</small><a href="https://angelscars.co.uk/" target="_blank" rel="noopener">angelscars.co.uk</a></div>
        <div class="chip"><small>Document Created</small><span>05 October 2026</span></div>
        <div class="chip"><small>Strategy Duration</small><span>4 Phases</span></div>
      </div>
      <div class="scroll-hint reveal"><i></i>Scroll to explore</div>
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="section" id="overview">
    <div class="wrap">
      <span class="eyebrow reveal">Overview</span>
      <h2 class="title reveal">The 4-Phase Roadmap</h2>
      <p class="lead reveal">From analysis and technical fixes to content, local authority and AI visibility. Each phase builds on the one before it and ends with a clear report.</p>
      <div class="roadmap" id="roadmap"></div>
    </div>
  </section>

  <!-- PHASES injected here -->
  <div id="phases"></div>

  <!-- CLOSING -->
  <section class="closing">
    <div class="wrap">
      <span class="eyebrow reveal">Summary</span>
      <h2 class="reveal">From Foundation to AI Visibility</h2>
      <p class="reveal">Phase 1: builds the analysis base <br>Phase 2: fixes the technical foundation <br>Phase 3: grows content, local presence and authority <br>Phase 4: secures visibility and citations across AI search platforms.</p>
      <a class="cta reveal" href="https://docs.google.com/document/d/1F3E9LrenU1rY1BK7EwsxNErYCqrTYyFFQl3GG4gR2SE/edit?usp=sharing" target="_blank" rel="noopener">Check out the Detailed SEO Plan</a>
    </div>
  </section>
</main>

<footer><div class="wrap">Angel Cars | SEO Strategy &amp; 4-Phase Implementation Plan | Created 05 October 2026</div></footer>

<button class="top" id="top" aria-label="Back to top"><svg viewBox="0 0 24 24"><path d="M6 15l6-6 6 6"/></svg></button>

<script>
const phases = [
  {
    n: 1, color: "#38bdf8", title: "Foundation & Analysis",
    short: "Understand the website, competitors, existing SEO performance and the areas that need improvement.",
    intro: "The first phase focuses on understanding the website, competitors, existing SEO performance, and the areas that need improvement.",
    sections: [
      { t: "Competitor Research", i: ["Competitor website analysis","Competitor SEO and content analysis","Backlink profile evaluation","Google Business Profile and review analysis","Social media presence assessment"] },
      { t: "Backlink Analysis", i: ["Existing backlink data collection and audit","Link quality assessment","Identification of potentially harmful or low-quality links","Competitor backlink benchmarking","Link-building opportunity identification"] },
      { t: "Search Console & Indexation", i: ["Google Search Console review","Indexation and coverage analysis","Identification of indexing issues","Sitemap submission and monitoring"] },
      { t: "Homepage Optimization", i: ["Keyword research","Competitor and ranking analysis","Homepage content optimization","Title and meta description optimization","Internal linking improvements","Implementation and testing"] },
      { t: "Keyword Research", i: ["Primary and secondary keyword identification","Competitor keyword analysis","Search intent assessment","Keyword opportunity and competition analysis"] },
      { t: "Meta Tag Optimization", i: ["Meta title optimization","Meta description optimization","Keyword and search-intent alignment","Implementation and testing"] },
      { t: "Website SEO Audit", i: ["Technical SEO review","On-page SEO analysis","Content quality assessment","Performance and usability review","Identification and prioritization of SEO issues"] },
      { t: "Existing Content Audit", i: ["Existing page content review","Content quality and keyword gap analysis","Identification of pages requiring updates","Identification of content expansion opportunities"] },
      { t: "Monthly Reporting", report: true, i: ["SEO performance analysis","Ranking and organic traffic metrics","Completed activities and improvements","Identified opportunities","Priorities for the next phase"] }
    ]
  },
  {
    n: 2, color: "#a78bfa", title: "Technical SEO Foundation & Service Page Development",
    short: "Resolve technical SEO issues and improve the website structure and core pages.",
    intro: "The second phase focuses on resolving technical SEO issues and improving the website structure and core pages.",
    sections: [
      { t: "Sitemap Optimization", i: ["Review and clean sitemap URLs","Remove unnecessary or outdated URLs","Ensure important pages are included","Submit and monitor the updated sitemap"] },
      { t: "Robots.txt Optimization", i: ["Audit the existing robots.txt file","Review allowed and blocked URLs","Ensure important search engine crawlers can access required content","Test and validate robots.txt rules"] },
      { t: "Image Optimization", i: ["Audit existing image alt tags","Add relevant and descriptive alt text","Fix missing or poorly optimized alt tags","Optimize image files where required"] },
      { t: "Structured Data Implementation", i: ["Audit existing schema markup","Identify relevant schema types","Implement structured data on target pages","Test and validate structured data"] },
      { t: "OpenGraph Optimization", i: ["Audit existing OpenGraph tags","Optimize OG titles and descriptions","Optimize OG image and URL tags","Test social sharing appearance"] },
      { t: "Heading Optimization", i: ["Review H1, H2, and H3 structure","Improve heading hierarchy","Integrate relevant keywords naturally","Implement and validate changes"] },
      { t: "Website Performance Optimization", i: ["Identify page speed issues","Optimize images, CSS, and JavaScript","Improve Core Web Vitals","Reduce unnecessary page resources","Monitor performance improvements"] },
      { t: "Technical Issue Resolution", i: ["Prioritize technical SEO issues","Implement fixes","Test implemented changes","Verify fixes through crawling and monitoring"] },
      { t: "Monthly Reporting", report: true, i: ["Technical SEO progress","Indexation and crawling updates","Performance improvements","Completed fixes","Next priorities"] }
    ]
  },
  {
    n: 3, color: "#34d399", title: "Content Development, Local SEO & Authority Building",
    short: "Expand content, improve key service pages and build stronger local and external SEO signals.",
    intro: "The third phase focuses on expanding the website's content, improving important service pages, and building stronger local and external SEO signals.",
    sections: [
      { t: "Primary Service Page Optimization", i: ["Keyword research for primary service pages","Search intent analysis","Content optimization","On-page SEO improvements","Internal linking optimization","Conversion-focused content improvements"] },
      { t: "Sub-Service and Location Pages Creation", i: ["Identify relevant sub-service and location pages opportunities","Keyword research","Search intent analysis","SEO-focused content creation","On-page optimization","Internal linking"] },
      { t: "Blog Content Development", i: ["Informational keyword research","Topic and content gap analysis","SEO-focused blog content creation","Internal linking to relevant service pages","Content optimization and publishing","Content performance monitoring"] },
      { t: "Google Business Profile Optimization", i: ["Optimize business information and categories","Add and optimize relevant services","Improve business descriptions","Add photos and supporting content","Improve local SEO signals","Review acquisition and response strategy"] },
      { t: "Local Citation Building", i: ["Identify relevant local directories","Create and optimize business listings","Maintain consistent business information","Review existing citations and identify opportunities"] },
      { t: "Social Profile Optimization", i: ["Identify relevant social platforms","Create or optimize business profiles","Maintain consistent branding and business information","Add website links","Strengthen brand presence across social platforms"] },
      { t: "Link Building & Digital Authority", i: ["Identify relevant link opportunities","Competitor link gap analysis","Relevant directory and industry placements","Digital PR and outreach opportunities","Brand mention opportunities"] },
      { t: "Monthly Reporting", report: true, i: ["Organic traffic and ranking performance","Content performance","Local SEO progress","Link acquisition results","Completed activities","Next priorities"] }
    ]
  },
  {
    n: 4, color: "#fbbf24", title: "AI SEO & AI Visibility",
    short: "Improve brand visibility across AI search engines and answer platforms, and strengthen the signals AI systems trust.",
    intro: "The fourth phase focuses on improving the brand's visibility across AI search engines and answer platforms, while strengthening the signals that help AI systems understand, trust, cite, and recommend the brand.",
    sections: [
      { t: "AI Visibility Foundation", i: ["AI search and discovery platform submissions where applicable","AI visibility tracking and monitoring setup","Structured data and entity information optimization","Social profile creation and optimization across relevant platforms","Educational and informational content development","Best-X and comparison-style content","Long-tail informational query targeting","People Also Ask and question-based content targeting"] },
      { t: "Authority & Trust Building", i: ["Job posting distribution across relevant platforms such as LinkedIn and Indeed","App store presence and optimization where applicable","Influencer and user-generated content campaigns","YouTube, TikTok, and Instagram brand presence","TF-IDF and topical content optimization where appropriate","Voice search optimization","Relevant Reddit participation and brand discussions","Quora question-and-answer strategy"] },
      { t: "Entity Authority & AI Citations", i: ["Wikipedia opportunities where eligibility and reliable sources support a listing","Entity optimization and knowledge graph signals","NLP-focused content optimization","Digital PR campaigns and media placements","Brand mentions across authoritative publications","Homepage authority improvement","Competitor comparison content","Semantic content optimization","Review acquisition across relevant platforms such as Trustpilot, G2, Google Business Profile, and other suitable review platforms"] },
      { t: "AI Search Monitoring & Optimization", i: ["Monitor brand visibility across major AI search platforms","Track brand mentions and citations","Identify queries where competitors are being mentioned instead","Identify content gaps from AI search results","Improve pages based on recurring AI search queries","Monitor changes in AI-generated brand recommendations and citations"] },
      { t: "Final Reporting", report: true, i: ["Overall SEO performance","Organic traffic and ranking growth","Technical SEO improvements","Content performance","Local SEO progress","Authority and backlink growth","AI visibility and citation performance","Recommendations and priorities for the next period"] }
    ]
  }
];

const pad = n => String(n).padStart(2, "0");

/* Nav links */
const links = document.getElementById("links");
links.innerHTML =
  `<a href="#overview" data-t="overview" style="--c:var(--p1)">Overview</a>` +
  phases.map(p => `<a href="#phase-${p.n}" data-t="phase-${p.n}" style="--c:${p.color}">Phase ${p.n}</a>`).join("");

/* Roadmap */
document.getElementById("roadmap").innerHTML = phases.map(p => `
  <a class="rm reveal" href="#phase-${p.n}" style="--c:${p.color}">
    <div class="dot">${p.n}</div>
    <h3>${p.title}</h3>
    <p>${p.short}</p>
    <span class="go">View phase &rarr;</span>
  </a>`).join("");

/* Phases */
document.getElementById("phases").innerHTML = phases.map(p => `
  <section class="phase" id="phase-${p.n}" style="--a:${p.color}">
    <div class="wrap">
      <div class="phase-head">
        <div>
          <span class="eyebrow reveal">Phase ${p.n} of 4</span>
          <h2 class="reveal">${p.title}</h2>
          <p class="reveal">${p.intro}</p>
        </div>
        <div class="phase-num" aria-hidden="true">${pad(p.n)}</div>
      </div>
      <div class="toc reveal">${p.sections.map(s => `<span>${s.t}</span>`).join("")}</div>
      <div class="grid">
        ${p.sections.map((s, k) => `
          <article class="card reveal ${s.report ? "report" : ""}">
            ${s.report ? '<span class="tagrep">Report</span>' : ""}
            <span class="num">${pad(k + 1)}</span>
            <h3>${s.t}</h3>
            <ul>${s.i.map(x => `<li>${x}</li>`).join("")}</ul>
          </article>`).join("")}
      </div>
    </div>
  </section>`).join("");

/* Reveal on scroll */
const io = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
}, { threshold: .08, rootMargin: "0px 0px -40px 0px" });
document.querySelectorAll(".reveal").forEach(el => io.observe(el));

/* Active nav link */
const targets = ["overview", ...phases.map(p => "phase-" + p.n)].map(id => document.getElementById(id));
const linkEls = [...links.querySelectorAll("a")];
const spy = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      linkEls.forEach(a => a.classList.toggle("on", a.dataset.t === e.target.id));
      const on = links.querySelector("a.on");
      if (on) {
        const left = on.offsetLeft - links.clientWidth / 2 + on.clientWidth / 2;
        links.scrollTo({ left, behavior: "smooth" });
      }
      document.documentElement.style.setProperty("--a", getComputedStyle(e.target).getPropertyValue("--a") || "#38bdf8");
    }
  });
}, { rootMargin: "-45% 0px -50% 0px" });
targets.forEach(t => t && spy.observe(t));

/* Progress + back to top */
const bar = document.getElementById("progress");
const topBtn = document.getElementById("top");
function onScroll(){
  const h = document.documentElement;
  const pct = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
  bar.style.width = pct + "%";
  topBtn.classList.toggle("show", h.scrollTop > 700);
  if (h.scrollTop < 300) linkEls.forEach(a => a.classList.remove("on"));
}
window.addEventListener("scroll", onScroll, { passive: true });
onScroll();
topBtn.onclick = () => window.scrollTo({ top: 0, behavior: "smooth" });
</script>
